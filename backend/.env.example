# ==============================================================================
# SERVICE ARCHITECTURE NOTE:
# 1. Database: Heroku Postgres (production) / Local PostgreSQL (local dev).
#    Prisma handles all ORM & data migrations.
# 2. Supabase: Strictly for object STORAGE (Menu images bucket).
#    Supabase Auth and direct Supabase database connections are decommissioned.
# ==============================================================================

# Server Configuration
PORT=5001
NODE_ENV=production

# Database (Heroku Postgres Essential-0: connection_limit=10, pool_timeout=15, sslmode=no-verify)
# Local Dev Example: postgresql://postgres:LocalDev2026x@localhost:5432/zovikpos_dev
DATABASE_URL="postgresql://user:password@host:5432/database?connection_limit=10&pool_timeout=15&sslmode=no-verify"

# Optional pool overrides; no hardcoded code fallback (Prisma default applies when unset).
DB_POOL_MAX=
DB_POOL_TIMEOUT_SECONDS=

# Security & Authentication (Required: Generate unique secrets for production)
JWT_SECRET="your-unique-production-jwt-access-secret"
JWT_REFRESH_SECRET="your-unique-production-jwt-refresh-secret"
QR_SECRET="your-unique-production-qr-cryptographic-secret"

# Frontend Origin for CORS & Socket.IO
FRONTEND_URL="https://zovik-pos.vercel.app"
CORS_ORIGINS="https://zovik-pos.vercel.app"

# AI / ML Service URL (FastAPI Service)
AI_SERVICE_URL="http://localhost:8000"

# Supabase Storage only
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"

# Hostinger mailbox (SMTP_PASS sirf local .env / Heroku config vars mein).
# Note: Hostinger email plan trial hai, expiry 2026-11-22; deploy/viva se pehle renew karna hai.
# SPF/DKIM/DMARC Hostinger panel mein verify karna hai.
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="support@zovikpos.store"
SMTP_PASS=
EMAIL_FROM="Zovik POS <support@zovikpos.store>"

# Groq Vision & LLM APIs
GROQ_API_KEY="your-groq-api-key"
GROQ_MODEL="qwen/qwen3.8-27b"

# PayFast Sandbox Gateway
PAYFAST_MERCHANT_ID="10046084"
PAYFAST_MERCHANT_KEY="5g23zd20hlv74"
PAYFAST_PASSPHRASE=""
PAYFAST_SANDBOX_URL="https://sandbox.payfast.co.za/eng/process"
PAYFAST_MODE="sandbox"

# Redis (optional locally; set to the Heroku add-on's REDIS_URL in production)
REDIS_URL=

# Session idle timeout; code default is 10 minutes.
SESSION_IDLE_MINUTES=
# Sweep job; SWEEP_ENABLED is disabled unless exactly "true"; interval default is 60 seconds.
SWEEP_ENABLED=
SWEEP_INTERVAL_SECONDS=
# Transaction wait/timeout defaults are 5000ms/15000ms.
TX_MAX_WAIT_MS=
TX_TIMEOUT_MS=
# Maximum image upload defaults to 5 MiB.
MAX_IMAGE_UPLOAD_BYTES=
# Request timeout defaults to 25000ms.
REQUEST_TIMEOUT_MS=

# Exception logging (local dated files in development; stdout only in production)
LOG_DIR="logs/exceptions"
LOG_TIMEZONE="Asia/Karachi"
LOG_RETENTION_DAYS="30"
LOG_LEVEL="info"
LOG_BURST_LIMIT_PER_MINUTE="10"
