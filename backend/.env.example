# Server Configuration
PORT=5001
NODE_ENV=production

# Database (PostgreSQL / Supabase / Neon)
DATABASE_URL="postgresql://user:password@host:port/database"

# Security & Authentication (Required: Generate unique secrets for production)
JWT_SECRET="your-unique-production-jwt-access-secret"
JWT_REFRESH_SECRET="your-unique-production-jwt-refresh-secret"
QR_SECRET="your-unique-production-qr-cryptographic-secret"

# Frontend Origin for CORS & Socket.IO
FRONTEND_URL="https://zovik-pos.vercel.app"
CORS_ORIGINS="https://zovik-pos.vercel.app"

# AI / ML Service URL (FastAPI Service)
AI_SERVICE_URL="http://localhost:8000"

# Supabase Storage & Services
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_KEY="your-service-role-key"

# Email Notifications (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# Groq Vision & LLM APIs
GROQ_API_KEY="your-groq-api-key"
GROQ_MODEL="qwen/qwen3.8-27b"
