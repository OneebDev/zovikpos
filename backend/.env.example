# Server Configuration
PORT=5001
NODE_ENV=production

# Database (Heroku Postgres Essential-0: connection_limit=10, pool_timeout=15, sslmode=no-verify)
DATABASE_URL="postgresql://user:password@host:5432/database?connection_limit=10&pool_timeout=15&sslmode=no-verify"

# Security & Authentication (Required: Generate unique secrets for production)
JWT_SECRET="your-unique-production-jwt-access-secret"
JWT_REFRESH_SECRET="your-unique-production-jwt-refresh-secret"
QR_SECRET="your-unique-production-qr-cryptographic-secret"

# Frontend Origin for CORS & Socket.IO
FRONTEND_URL="https://zovik-pos.vercel.app"
CORS_ORIGINS="https://zovik-pos.vercel.app"

# AI / ML Service URL (FastAPI Service)
AI_SERVICE_URL="http://localhost:8000"

# Supabase Storage & Services
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"

# Email Notifications (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# Groq Vision & LLM APIs
GROQ_API_KEY="your-groq-api-key"
GROQ_MODEL="qwen/qwen3.8-27b"

# Redis (optional locally; set to the Heroku add-on's REDIS_URL in production)
REDIS_URL=

# Exception logging (local dated files in development; stdout only in production)
LOG_DIR="logs/exceptions"
LOG_TIMEZONE="Asia/Karachi"
LOG_RETENTION_DAYS="30"
LOG_LEVEL="info"
LOG_BURST_LIMIT_PER_MINUTE="10"
