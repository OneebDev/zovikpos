# Frontend Environment Variables (Vercel Production & Local Development)
# Only variable names and documentation are listed here.
# Copy this file to .env and fill in values for your environment.

# Backend REST API URL (without /api suffix)
# Local:      http://localhost:5001
# LAN dev:    http://<your-local-ip>:5001
# Production: https://your-backend-app.herokuapp.com
VITE_API_URL=

# Backend Socket.IO URL (same host as API URL)
# Local:      http://localhost:5001
# LAN dev:    http://<your-local-ip>:5001
# Production: https://your-backend-app.herokuapp.com
VITE_SOCKET_URL=
